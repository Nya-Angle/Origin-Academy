{
  "name": "@profer/electron",
  "version": "1.0.0",
  "description": "CDUT Studio",
  "main": "dist/main.cjs",
  "author": "CDUT Studio Devs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,green \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite dev",
    "dev:electron": "npm run build:main && npm run build:app-preload && npm run build:yanhu-preload && electron . --dev",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --outfile=dist/main.cjs --external:electron",
    "build:app-preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron",
    "build:yanhu-preload": "esbuild src/main/lib/cdut/yanhu/yanhu-preload.ts --bundle --platform=node --format=cjs --outfile=dist/yanhu-preload.cjs --external:electron",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:app-preload && npm run build:yanhu-preload && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && electron-builder --dir -c.electronDist=../../node_modules/electron/dist",
    "dist:win": "npm run build && electron-builder --win portable --x64 -c.electronDist=../../node_modules/electron/dist",
    "dist:mac": "npm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@profer/shared": "*"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "jotai": "^2.10.0",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.0.0",
    "vite": "^6.0.3"
  },
  "build": {
    "extends": "electron-builder.yml"
  }
}
